# Copy to .env.local and fill in. Never commit .env.local.

# Public site URL, used for canonical links, sitemap and WhatsApp detail links.
NEXT_PUBLIC_SITE_URL=https://geckodan.example

# Supabase project that belongs to GeckoDan (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The anon / publishable key. Safe for the browser: Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Never put the service-role key in this app. It is not used anywhere.
